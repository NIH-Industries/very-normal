#!/usr/bin/env bash
# Builds Very Normal Compose.app.
#
#   mac/build                        # build into tmp/mac/
#   mac/build --install              # and copy it to ~/Applications
#   mac/build --release [--no-notarise]
#                                    # universal, notarised and stapled, zipped
#                                    # for the GitHub release and the cask
#
# Signs with your Developer ID when it's in your keychain, so a build from a
# checkout and the one from Homebrew are the same app to macOS and the
# Accessibility permission carries over between them. Otherwise your Apple
# Development certificate, then ad-hoc ($CODESIGN_IDENTITY picks another); an
# ad-hoc signature has to be allowed again after every build.
#
# --release needs the Developer ID Application certificate and notarytool
# credentials saved as the `notary` profile ($NOTARY_PROFILE picks another):
#   xcrun notarytool store-credentials notary
# It leaves tmp/mac/release/VeryNormalCompose-<version>.zip, the version taken
# from Cargo.toml. --no-notarise skips Apple, for a dry run.
set -euo pipefail
cd "$(dirname "$0")/.."

mode=build
notarise=true
for arg in "$@"; do
  case "$arg" in
    --install) mode=install ;;
    --release) mode=release ;;
    --no-notarise) notarise=false ;;
    *) echo "usage: $0 [--install | --release [--no-notarise]]" >&2; exit 2 ;;
  esac
done

version=$(sed -n '/^\[package\]/,/^\[/s/^version = "\(.*\)"/\1/p' Cargo.toml | head -1)
out=tmp/mac
[[ $mode == release ]] && out=tmp/mac/release
app="$out/Very Normal Compose.app"
identities=$(security find-identity -v -p codesigning 2>/dev/null || true)
pick() { sed -n "s/.*\"\($1:[^\"]*\)\".*/\1/p" <<<"$identities" | head -1; }

if [[ $mode == release ]]; then
  identity="${CODESIGN_IDENTITY:-$(pick "Developer ID Application")}"
  [[ -n "$identity" ]] || { echo "mac/build: --release needs a Developer ID Application certificate" >&2; exit 1; }
else
  identity="${CODESIGN_IDENTITY:-$(pick "Developer ID Application")}"
  identity="${identity:-$(pick "Apple Development")}"
fi

rm -rf "$out"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
cp mac/Info.plist "$app/Contents/Info.plist"
/usr/libexec/PlistBuddy -c "Set :CFBundleShortVersionString $version" "$app/Contents/Info.plist"

# the icon, drawn by mac/icon.swift
set_dir="$out/AppIcon.iconset"
mkdir -p "$set_dir"
swift mac/icon.swift "$out/icon.png"
for n in 16 32 128 256 512; do
  sips -z $n $n "$out/icon.png" --out "$set_dir/icon_${n}x${n}.png" >/dev/null
  sips -z $((n * 2)) $((n * 2)) "$out/icon.png" --out "$set_dir/icon_${n}x${n}@2x.png" >/dev/null
done
iconutil -c icns "$set_dir" -o "$app/Contents/Resources/AppIcon.icns"

bin="$app/Contents/MacOS/VeryNormalCompose"
if [[ $mode == release ]]; then
  for arch in arm64 x86_64; do
    swiftc -O -swift-version 5 -target "$arch-apple-macos14.0" -o "$out/VeryNormalCompose-$arch" mac/main.swift
  done
  lipo -create "$out/VeryNormalCompose-arm64" "$out/VeryNormalCompose-x86_64" -output "$bin"
else
  swiftc -O -swift-version 5 -target arm64-apple-macos14.0 -o "$bin" mac/main.swift
fi

if [[ $mode == release ]]; then
  codesign --force --timestamp --options runtime --sign "$identity" "$app"
else
  codesign --force --options runtime --sign "${identity:--}" "$app"
fi
echo "Built $app $version (signed: ${identity:-ad-hoc})"

case $mode in
install)
  pkill -x VeryNormalCompose 2>/dev/null || true
  rm -rf "$HOME/Applications/Very Normal Compose.app"
  mkdir -p "$HOME/Applications"
  cp -R "$app" "$HOME/Applications/"
  echo "Installed to ~/Applications/Very Normal Compose.app"
  ;;
release)
  codesign --verify --strict --deep "$app"
  zip="$out/VeryNormalCompose-$version.zip"
  if $notarise; then
    ditto -c -k --keepParent "$app" "$out/notarise.zip"
    xcrun notarytool submit "$out/notarise.zip" --keychain-profile "${NOTARY_PROFILE:-notary}" --wait
    xcrun stapler staple "$app"
    spctl --assess --type execute --verbose "$app"
  fi
  ditto -c -k --keepParent "$app" "$zip"
  echo "Zipped $zip"
  ;;
esac
